{
  "name": "parts-bin",
  "version": "0.1.0",
  "description": "A token-driven, brand-agnostic, reduced-motion-safe library of React/Next.js scroll-animation section components (GSAP + a few CSS-only atoms).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "nextjs",
    "gsap",
    "scrolltrigger",
    "animation",
    "scroll-animation",
    "components",
    "design-system",
    "reduced-motion"
  ],
  "sideEffects": [
    "**/*.tsx"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "publish-check": "node scripts/publish-check.mjs",
    "publish-check:self": "node scripts/publish-check.mjs --self-test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "gsap": ">=3.12",
    "@gsap/react": ">=2"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "peerDependencies_note": "three is only needed if you import RibbonPeelRevealWithSphere; it is dynamically imported so DOM/CSS-only consumers never pull it in.",
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.1.18",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "three": "^0.169.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.5.4"
  }
}
